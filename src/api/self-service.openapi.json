  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "JWT bearer token issued by POST /api/v1/auth/login (staff) or /api/v1/customer/auth/login (customer).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiEnvelope": {
        "description": "Uniform success envelope.",
        "properties": {
          "data": {
            "description": "Primary payload."
          },
          "meta": {
            "description": "Pagination / extra metadata.",
            "type": [
              "object",
              "null"
            ]
          },
          "message": {
            "description": "Human readable message.",
            "type": [
              "string",
              "null"
            ]
          },
          "request_id": {
            "description": "Correlation id for the request.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "AuthTokenResponse": {
        "description": "Successful authentication payload.",
        "properties": {
          "token": {
            "description": "JWT bearer token.",
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "default": "bearer"
          },
          "expires_in": {
            "description": "Token lifetime in seconds.",
            "type": "integer"
          },
          "user": {
            "description": "Authenticated principal.",
            "type": "object"
          }
        },
        "type": "object"
      },
      "ChangeCustomerPasswordRequest": {
        "description": "Request body for `.POST /api/v1/customer/me/password`.",
        "required": [
          "current_password",
          "password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "password": {
            "description": "must match the confirmation field",
            "type": "string",
            "minLength": 8
          }
        },
        "type": "object"
      },
      "CustomerLoginRequest": {
        "description": "Request body for `.POST /api/v1/customer/auth/login`.",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CustomerRegisterRequest": {
        "description": "Request body for `.POST /api/v1/customer/auth/register`.",
        "required": [
          "first_name",
          "last_name",
          "email",
          "phone",
          "password",
          "organization_code"
        ],
        "properties": {
          "first_name": {
            "type": "string",
            "maxLength": 255
          },
