    },
    "/customer/auth/refresh": {
      "post": {
        "tags": [
          "Customer Authentication"
        ],
        "summary": "Refresh an expiring customer JWT.",
        "description": "Public endpoint. Exchanges a still-refreshable JWT (within the configured refresh window) for a new token. The previous token is blacklisted, so every refresh rotates the session.",
        "operationId": "customerRefreshToken",
        "responses": {
          "200": {
            "description": "New token issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token missing, invalid, or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
