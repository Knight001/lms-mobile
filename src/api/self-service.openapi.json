{
  "openapi": "3.1.0",
  "info": {
    "title": "FinLend self-service API",
    "version": "1.0.0",
    "description": "Customer-facing endpoints only, generated from the API's OpenAPI document. Do not edit by hand."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1"
    }
  ],
  "paths": {
    "/customer/auth/register": {
      "post": {
        "tags": [
          "Customer Authentication"
        ],
        "summary": "Start customer self-service registration.",
        "description": "Public endpoint. Creates a pending customer and delivers a verification code.",
        "operationId": "customerRegister",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerRegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Verification code dispatched.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/customer/auth/verify": {
      "post": {
        "tags": [
          "Customer Authentication"
        ],
        "summary": "Verify a customer account with the delivered code.",
        "description": "Public endpoint. Confirms the code and issues the first customer JWT.",
        "operationId": "customerVerify",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account verified.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/AuthTokenResponse"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Invalid or expired code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/customer/auth/resend-code": {
      "post": {
        "tags": [
          "Customer Authentication"
        ],
        "summary": "Re-deliver the verification code.",
